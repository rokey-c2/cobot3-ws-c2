# ============================================================
# LocateBox.srv
# 영상인식 <-> 로봇팔(P3020) : 박스 위치 요청/응답 서비스
# ============================================================
#
# 흐름
# ----
# 1) 로봇팔이 release_lock=false 로 호출한다.
#    - 영상인식이 아직 박스 좌표를 잠그지 않은 상태라면, 새로 검출/계산해서
#      좌표를 반환하고 내부적으로 그 좌표를 "잠금(lock)" 상태로 고정한다.
#    - 이미 잠긴 상태라면 재계산하지 않고 같은 좌표를 그대로 반환한다.
#      (position_locked=true 로 "새로 계산한 값이 아님"을 알려준다.)
#    - 즉 Pick 동작 도중 이 서비스를 반복 호출해도 좌표가 흔들리지 않는다.
#
# 2) 로봇팔이 Pick을 완료하면 ConfirmGrasp.srv 로 성공/실패를 확인한다.
#
# 3) 다음 박스로 넘어갈 때, 로봇팔이 release_lock=true 로 LocateBox 를
#    호출한다. 영상인식은 이때 잠금을 해제하고 새로운 검출을 시작한다.
#
# ============================================================

# ---- Request: 로봇팔 -> 영상인식 ----
bool release_lock
# true  : 이전에 잠근 좌표를 해제하고 새로 검출을 시작한다.
#         (Pick 완료 직후, 다음 사이클을 시작할 때 호출)
# false : 잠겨 있으면 같은 좌표 유지, 안 잠겨 있으면 새로 검출해서 잠근다.
#         (Pick 진행 중 반복 호출해도 안전한 기본 호출 방식)

---

# ---- Response: 영상인식 -> 로봇팔 ----
bool box_detected
# 카메라 시야에 박스가 검출되었는지 여부.
# false 이면 box_position 은 의미 없는 값(0,0,0)이다.

geometry_msgs/Point box_position
# 박스 3D 좌표 (카메라 좌표계, meter 단위)

bool position_locked
# true  : 이번에 반환한 좌표는 "잠긴(고정된)" 좌표다.
#         이전 응답과 값이 같더라도 새로 계산한 결과가 아니라는 뜻이므로,
#         로봇팔은 이 좌표를 그대로 신뢰하고 재계산 결과로 오인하지 않는다.
# false : 이번 호출에서 새로 검출/계산해서 반환한 좌표다.
#         (release_lock=true 로 호출한 직후 등)
