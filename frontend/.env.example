# Leave empty during local Vite development to use vite.config.js proxy -> localhost:8000.
VITE_API_BASE_URL=

# Optional MJPEG URL for the AMR Control live camera.
# Example: http://localhost:8090/camera/amr_in
VITE_AMR_CAMERA_STREAM_URL=

# Control Tower 3-slide live monitor.
# When empty, each stream uses the current web hostname with the default port.
VITE_TOP_VIEW_STREAM_URL=
VITE_P3020_IN_CAMERA_STREAM_URL=
VITE_P3020_OUT_CAMERA_STREAM_URL=

# Legacy P3020 IN setting. Kept for compatibility with existing local .env files.
# VITE_P3020_IN_CAMERA_STREAM_URL takes priority when both are set.
VITE_P3020_CAMERA_STREAM_URL=
