import omni.usd
from pxr import UsdPhysics, PhysxSchema

stage = omni.usd.get_context().get_stage()

# 현재 열어둔 USD에 직접 저장

stage.SetEditTarget(stage.GetRootLayer())

# 원하는 Initial Joint State

home_positions = {
"/World/p3020_in/p3020/joints/joint_1": 0.1,
"/World/p3020_in/p3020/joints/joint_2": 30.3,
"/World/p3020_in/p3020/joints/joint_3": 93.0,

```
# joint_4는 FixedJoint라서 제외

"/World/p3020_in/p3020/joints/joint_5": 52.3,
"/World/p3020_in/p3020/joints/joint_6": -72.2,
```

}

def find_joint_axis(joint):
# 일반적인 Revolute Joint
if joint.IsA(UsdPhysics.RevoluteJoint):
return UsdPhysics.Tokens.angular

```
# Prismatic Joint
if joint.IsA(UsdPhysics.PrismaticJoint):
    return UsdPhysics.Tokens.linear

# 일반 PhysicsJoint(D6 등)의 회전축 찾기
applied_schemas = joint.GetAppliedSchemas()

for axis in ("rotX", "rotY", "rotZ"):
    for schema in applied_schemas:
        if schema.endswith(":" + axis):
            return axis

return None
```

for joint_path, position in home_positions.items():

```
joint = stage.GetPrimAtPath(joint_path)

if not joint.IsValid():
    print("[NOT FOUND]", joint_path)
    continue

print()
print("Joint:", joint_path)
print("Type :", joint.GetTypeName())

# Fixed Joint는 Initial angular position이 없음
if joint.IsA(UsdPhysics.FixedJoint):
    print("[SKIP] Fixed Joint")
    continue

axis = find_joint_axis(joint)

if axis is None:
    print("[ERROR] 회전축을 찾지 못했습니다.")
    print("Applied Schemas:")
    for schema in joint.GetAppliedSchemas():
        print("   ", schema)
    continue

# Initial Joint State API
state = PhysxSchema.JointStateAPI.Apply(
    joint,
    axis
)

# Initial Position
position_attr = state.CreatePositionAttr()
position_attr.Set(float(position))

# Initial Velocity
velocity_attr = state.CreateVelocityAttr()
velocity_attr.Set(0.0)

# 실제 저장된 값 다시 읽어서 확인
saved_position = state.GetPositionAttr().Get()

print(
    f"[SET] axis={axis}, "
    f"Initial Position={saved_position}"
)
```

stage.Save()

print()
print("===================================")
print("P3020 Initial Joint State 저장 완료")
print("===================================")
