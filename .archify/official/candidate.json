  "cards": [
    {
      "dot": "cyan",
      "title": "ROS 2 Actions",
      "items": [
        "/navigate_to_pose — Nav2 server; mission + ros2_mqtt_adapter are clients",
        "/p3020/pick_place — Host ROS 2 PickPlace Action Server; mission is the client"
      ]
    },
    {
      "dot": "emerald",
      "title": "MQTT Adapter Processes",
      "items": [
        "Four independent MQTT clients: ros2_mqtt_adapter, ros2_manual_mqtt_adapter, process_mqtt_adapter, pose_sync_manager",
        "Mosquitto is the central broker; FastAPI is another MQTT client",
        "React talks to FastAPI through HTTP/REST"
      ]
    },
    {
      "dot": "rose",
      "title": "ROS vs Isaac Internal Calls",
      "items": [
        "ROS-labelled edges represent ROS 2 Topic / Action communication",
        "Dashed Python API edges inside Isaac Sim are in-process calls, not ROS topics",
        "MissionIwHubAgent, ProcessEquipmentBridge and P3020 agents are not independent ROS nodes"
      ]
    },
    {
      "dot": "cyan",
      "title": "AMR Navigation Loop",
      "items": [
        "Nav2 sends /cmd_vel through IW Hub ROS2 Graphs",
        "IW Hub ROS2 Graphs returns /scan, /odom, /tf and /clock",
        "IW Hub AMR is the simulated robot object; isaac_amr_mission_bridge is the ROS ↔ Isaac bridge node"
      ]
    }
  ]
