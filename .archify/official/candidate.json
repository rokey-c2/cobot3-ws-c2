      ]
    },
    {
      "dot": "emerald",
      "title": "Four MQTT Adapter Nodes",
      "items": [
        "ros2_mqtt_adapter — navigation command/state",
        "ros2_manual_mqtt_adapter — manual cmd_vel and lift control",
        "process_mqtt_adapter — equipment commands, status and process events",
        "pose_sync_manager — map_pose, restore_pose, /initialpose and TF checks"
      ]
    },
    {
      "dot": "rose",
      "title": "Isaac Internal Components",
      "items": [
        "MissionIwHubAgent",
        "P3020PickPlaceAgent and P3020OutAgent",
        "ProcessEquipmentBridge",
        "ConveyorController and WheelSorterController",
        "These are attached Python components, not independent ROS 2 nodes"
      ]
    },
    {
      "dot": "cyan",
      "title": "Navigation Loop",
      "items": [
        "Nav2 sends /cmd_vel through IW Hub ROS2 Graphs",
        "IW Hub ROS2 Graphs returns /scan, /odom, /tf and /clock",
        "IW Hub AMR is the simulated robot; isaac_amr_mission_bridge is the rclpy bridge node"
      ]
    }
