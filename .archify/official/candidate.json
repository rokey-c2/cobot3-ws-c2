  "cards": [
    {
      "dot": "cyan",
      "title": "ROS 2 Action Paths",
      "items": [
        "/navigate_to_pose: Nav2 server; amr_p3020_mission and ros2_mqtt_adapter are clients",
        "/p3020/pick_place: Host ROS 2 PickPlace Action Server; amr_p3020_mission is the client"
      ]
    },
    {
      "dot": "emerald",
      "title": "MQTT Adapter Details",
      "items": [
        "ros2_mqtt_adapter: navigation command/state",
        "ros2_manual_mqtt_adapter: /cmd_vel and lift/manual control",
        "process_mqtt_adapter: equipment command/status and process events",
        "pose_sync_manager: /amr_a/map_pose, restore_pose, /initialpose and TF map→base_link"
      ]
    },
    {
      "dot": "rose",
      "title": "Mission / Isaac Feedback",
      "items": [
        "amr_p3020_mission publishes pickup/lift commands to isaac_amr_mission_bridge",
        "isaac_amr_mission_bridge returns pickup/lift state and result topics",
        "PickPlace Action Server exchanges Isaac-compatible String command/status with the bridge"
      ]
    },
    {
      "dot": "cyan",
      "title": "Isaac Internal Components",
      "items": [
        "MissionIwHubAgent",
        "P3020PickPlaceAgent and P3020OutAgent",
        "ProcessEquipmentBridge",
        "ConveyorController and WheelSorterController",
        "These are Python components attached inside Isaac, not independent ROS nodes"
      ]
    },
    {
      "dot": "emerald",
      "title": "Navigation Feedback",
      "items": [
        "Nav2 sends /cmd_vel through IW Hub ROS2 Graphs",
        "IW Hub ROS2 Graphs returns /scan, /odom, /tf and /clock to the navigation stack",
        "IW Hub AMR is the simulated robot object"
      ]
    }
  ]
