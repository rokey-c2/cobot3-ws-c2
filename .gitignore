# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.venv/
venv/

# ROS2 build artifacts
build/
install/
log/

# Frontend
node_modules/
dist/

# IDE / OS
.vscode/
.idea/
.DS_Store

# Environment / secrets
.env
*.env

# Local runtime process manager state
.runtime/

# Isaac Sim / Omniverse local cache & logs
.cache/
.omniverse/
*.log

# Large/local simulation assets
# Keep these outside Git unless the team explicitly decides otherwise.
# *.usd
# *.usda
# *.usdc
# *.urdf
# *.dae
# *.stl
# *.obj
# *.fbx

# Keep empty asset directories in Git
!isaac_sim/usd/.gitkeep
!isaac_sim/assets/**/.gitkeep

# Synthetic data generation output (Replicator captures, YOLO datasets, zips)
isaac_sim/data/
_out_parcel_sdg/

# Trained model weights (large binaries, keep outside Git)
isaac_sim/robots/p3020/vision/models/

# Offline test ros2 bags (large binaries, keep outside Git)
tests/ros2/*/
!tests/ros2/.gitkeep
